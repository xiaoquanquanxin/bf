{
  "name": "chatbot-ts",
  "version": "1.0.0",
  "description": "TypeScript chatbot backend with LLM",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepare": "husky",
    "mcp:math": "ts-node ./src/mcpServer/math_server.ts"
  },
   "lint-staged": {
    "*.{ts,js}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@langchain/core": "1.1.8",
    "@langchain/langgraph": "1.0.7",
    "@langchain/mcp-adapters": "1.1.1",
    "@langchain/openai": "1.2.0",
    "@modelcontextprotocol/sdk": "1.25.1",
    "dotenv": "17.2.3",
    "express": "4.22.1",
    "langchain": "1.2.3",
    "three": "0.158.0",
    "uuid": "9.0.1",
    "ws": "8.18.3",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.10.0",
    "@types/three": "0.158.3",
    "@types/uuid": "9.0.7",
    "@types/ws": "8.18.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "tsx": "4.21.0",
    "typescript": "5.3.3"
  }
}
